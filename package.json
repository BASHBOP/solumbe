{
  "name": "@bashbop/solumbe",
  "version": "4.2.1",
  "mcpName": "io.github.BASHBOP/solumbe",
  "description": "Solumbe: deterministic local repository context, impact analysis, and merge evidence.",
  "type": "module",
  "bin": {
    "solumbe": "src/cli.js"
  },
  "files": [
    "assets",
    "evals",
    "src",
    "scripts",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "postinstall": "node scripts/postinstall.mjs",
    "build": "echo \"no build step required\"",
    "mcp": "node src/cli.js mcp",
    "doctor": "node src/cli.js doctor",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "version:check": "node scripts/check-version.js",
    "version": "node scripts/sync-server-version.mjs && npm run docs:diagram && git add server.json docs/index.md RELEASE.md docs/assets/solumbe-how-it-works.html",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-lines=70 --test-coverage-branches=60 --test-coverage-functions=75 tests/*.test.js",
    "audit": "npm audit --omit=dev",
    "benchmark:cli": "node scripts/benchmark-cli.mjs",
    "smoke": "node src/cli.js doctor && node src/cli.js harness . --json && npm run smoke:tarball",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run version:check && npm run rebrand:check && npm run docs:diagram:check && npm test && npm run test:coverage && npm run eval:accuracy && npm run eval:harness && npm run eval:gate && npm run audit && npm run smoke",
    "ci": "npm run quality",
    "prepublishOnly": "npm run ci",
    "smoke:tarball": "node scripts/smoke-tarball.mjs",
    "rebrand:plan": "node scripts/rebrand.mjs plan",
    "rebrand:check": "node scripts/rebrand.mjs check",
    "eval:accuracy": "node src/cli.js eval --accuracy",
    "eval:harness": "node src/cli.js eval --harness",
    "eval:gate": "node src/cli.js eval --gate-effectiveness",
    "docs:diagram": "node scripts/generate-how-it-works.mjs",
    "docs:diagram:check": "node scripts/generate-how-it-works.mjs --check",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:check": "node scripts/sync-skills.mjs --check"
  },
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BASHBOP/solumbe.git"
  },
  "homepage": "https://bashbop.github.io/solumbe/",
  "bugs": {
    "url": "https://github.com/BASHBOP/solumbe/issues"
  },
  "keywords": [
    "cli",
    "mcp",
    "mcp-server",
    "code-context",
    "code-map",
    "agent",
    "pr-review",
    "merge-gate",
    "repository-analysis",
    "developer-tools",
    "otito"
  ],
  "license": "MIT",
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "prettier": "^3.8.3"
  }
}
