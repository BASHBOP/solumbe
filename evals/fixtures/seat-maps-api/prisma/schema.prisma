model SeatMap {
  id      String @id
  eventId String
  builder Json
  seats   Seat[]
}

model Seat {
  id        String  @id
  seatMapId String
  rowLabel  String
  label     String
  blocked   Boolean @default(false)
  seatMap   SeatMap @relation(fields: [seatMapId], references: [id])
}

model Booking {
  id      String @id
  eventId String
  status  String
}
